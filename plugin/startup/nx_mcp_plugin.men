!
! NX MCP Plugin — Main Menu
!
VERSION 120

EDIT UG_GATEWAY_MAIN_MENUBAR

BEFORE UG_HELP
    CASCADE_BUTTON NX_MCP_PLUGIN_MENU
    LABEL NX MCP Plugin
END_OF_BEFORE

MENU NX_MCP_PLUGIN_MENU

BUTTON NX_MCP_TOGGLE_SERVER
LABEL Toggle MCP Server
ACTIONS NX_MCP_TOGGLE_SERVER

SEPARATOR

BUTTON NX_MCP_SHOW_STATUS
LABEL Plugin Status
ACTIONS NX_MCP_SHOW_STATUS

SEPARATOR

BUTTON NX_MCP_HOVER_CAPTURE
LABEL Capture Hover
ACTIONS NX_MCP_HOVER_CAPTURE

END_OF_MENU
